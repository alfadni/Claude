{
  "name": "masroof",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "e2e": "maestro test e2e",
    "prepare": "cd .. && husky masroof/.husky || true"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "drizzle-orm": "0.45.4",
    "expo": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.6",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.9",
    "expo-haptics": "~58.0.6",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.4",
    "expo-router": "~58.0.20",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.18",
    "expo-splash-screen": "~58.0.9",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "i18next": "26.4.6",
    "react": "19.3.0",
    "react-i18next": "17.0.18",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "better-sqlite3": "13.0.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --check"
    ]
  }
}
